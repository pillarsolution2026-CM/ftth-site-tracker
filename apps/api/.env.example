# Copy to .env for local development (never commit the real file).
NODE_ENV=development
PORT=3001

DATABASE_URL=postgres://ftth:ftth@localhost:5432/ftth
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ftth
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000
