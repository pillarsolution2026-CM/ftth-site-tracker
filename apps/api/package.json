{
  "name": "@ftth/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "start": "node dist/main.js",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js"
  },
  "dependencies": {
    "@ftth/shared": "workspace:*",
    "@nestjs/common": "12.3.1",
    "@nestjs/core": "12.3.1",
    "@nestjs/platform-express": "12.3.1",
    "@nestjs/swagger": "12.0.5",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.1",
    "@swc/core": "1.16.20",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
