# Copy to /srv/ftthtracker/.env on the server (owner ftthtracker, chmod 600). Never commit real values.
# Web/API listen on 127.0.0.1 only; the host Caddy (infra/ftth.caddy) proxies to them.
WEB_PORT=3200
API_PORT=3201
APP_DOMAIN=ftth.example.com
CORS_ORIGINS=https://ftth.example.com

# PostGIS and Redis must already be reachable from the server (no Docker for this user).
DATABASE_URL=
REDIS_URL=
# At least 32 characters, must not contain "change-me".
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MAX_UPLOAD_MB=100
APP_ORIGIN=https://ftth.example.com
# Required by the env schema even while STORAGE_DRIVER=fs (placeholders are fine).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
