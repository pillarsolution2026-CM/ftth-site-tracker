# Reference only: bootstrap.sh writes /srv/ftth/.env (owner ftth-deploy, chmod 600) with random secrets.
# Every value is required by docker-compose.yml.

APP_DOMAIN=staging.ftthtracker.projectflow.site
API_DOMAIN=api.staging.ftthtracker.projectflow.site

# Loopback ports the host Caddy proxies to (bootstrap picks free ones and renders the Caddy snippet).
WEB_PORT=3310
API_PORT=3311
MARTIN_PORT=3312
BACKUP_DIR=/srv/ftth/backups

# IMAGE_TAG is set by the deploy script; keep a value for manual runs.
IMAGE_REGISTRY=ghcr.io/pillarsolution2026-cm/ftth-site-tracker
IMAGE_TAG=staging

POSTGRES_USER=ftth
POSTGRES_PASSWORD=
POSTGRES_DB=ftth

REDIS_PASSWORD=

# At least 32 characters; must not contain "change-me" (rejected in production).
JWT_ACCESS_SECRET=

# Tiles (ADR-031). bootstrap.sh adds these to an existing server too. Secret: at least 32 characters.
TILE_URL_SECRET=
FTTH_TILES_PASSWORD=
TILES_PUBLIC_URL=https://api.staging.ftthtracker.projectflow.site

# Files (CAD originals, PDFs, xlsx) are stored on the `ftth-storage` Docker volume (STORAGE_DRIVER=fs,
# STORAGE_FS_ROOT=/var/lib/ftth/storage; fixed in docker-compose.yml). Back the volume up with the database.
# Largest accepted upload in MiB (optional, default 100).
MAX_UPLOAD_MB=100
# Name of the CAD worker (optional, default worker-1); unique per worker.
WORKER_ID=worker-1

# Hetzner Object Storage (S3-compatible). Only used when STORAGE_DRIVER=s3; the compose file still
# requires the four values (placeholders are fine while files live on the volume).
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=ftth-staging
S3_ACCESS_KEY=
S3_SECRET_KEY=
