# Reference only: bootstrap.sh writes /srv/ftth/.env (owner ftth-deploy, chmod 600) with random secrets.
# Every value is required by docker-compose.yml.

APP_DOMAIN=staging.ftthtracker.projectflow.site
API_DOMAIN=api.staging.ftthtracker.projectflow.site

# Loopback ports the host Caddy proxies to (bootstrap picks free ones and renders the Caddy snippet).
WEB_PORT=3310
API_PORT=3311
BACKUP_DIR=/srv/ftth/backups

# IMAGE_TAG is set by the deploy script; keep a value for manual runs.
IMAGE_REGISTRY=ghcr.io/pillarsolution2026-cm/ftth-site-tracker
IMAGE_TAG=staging

POSTGRES_USER=ftth
POSTGRES_PASSWORD=
POSTGRES_DB=ftth

REDIS_PASSWORD=

# At least 32 characters; must not contain "change-me" (rejected in production).
JWT_ACCESS_SECRET=

# Hetzner Object Storage (S3-compatible). Not used until Phase 1 uploads, but required by config.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=ftth-staging
S3_ACCESS_KEY=
S3_SECRET_KEY=
