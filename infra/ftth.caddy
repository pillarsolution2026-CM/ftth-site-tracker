# Site block for the HOST Caddy (needs root to install: add `import /path/to/ftth.caddy` to /etc/caddy/Caddyfile,
# then `caddy validate` and `systemctl reload caddy`). Replace the domain; ports match infra/ftth.env.example.
# The web app proxies /api calls to the API itself (API_URL), so one domain is enough.
ftth.example.com {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3200
}
