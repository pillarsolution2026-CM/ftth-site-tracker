# Copy to infra/.env to override the development defaults in docker-compose.yml.
POSTGRES_USER=ftth
POSTGRES_PASSWORD=ftth
POSTGRES_DB=ftth

REDIS_PASSWORD=ftth-redis-dev
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=ftth

# At least 32 characters. Never reuse the dev default outside your machine.
JWT_ACCESS_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000

# File storage (ADR-012). `fs` keeps files on the shared `ftth-storage` volume; `s3` uses MinIO (S3_BUCKET above).
STORAGE_DRIVER=fs
# Largest accepted upload (CAD, PDF, xlsx) in MiB.
MAX_UPLOAD_MB=100
# Name of this CAD worker (used for its Redis in-flight list); must be unique per worker.
WORKER_ID=worker-1

# Tiles (ADR-021, Phase 1b). DEV ONLY values: production secrets are generated, see docs/DEPLOY.md.
# Password of the restricted Postgres role ftth_tiles that Martin connects as.
FTTH_TILES_PASSWORD=ftth-tiles-dev
# HMAC key for signed tile URLs, at least 32 characters.
TILE_URL_SECRET=dev-only-tile-secret-change-me-dev-only-tile-secret
# Public base URL of Martin (behind Caddy in production); in dev it is Martin itself.
TILES_PUBLIC_URL=http://localhost:3002
